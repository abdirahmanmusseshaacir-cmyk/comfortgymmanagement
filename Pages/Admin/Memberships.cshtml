@page
@{
    ViewData["Title"] = "Memberships";
}

<style>

    /* =========================================
       MEMBERSHIPS PAGE
       ========================================= */

    .membership-page {
        width: 100%;
        box-sizing: border-box;
    }

    /* =========================================
       HERO SECTION
       ========================================= */

    .membership-hero {
        position: relative;
        min-height: 220px;

        margin-bottom: 24px;

        border-radius: 18px;
        overflow: hidden;

        display: flex;
        align-items: center;

        background:
            linear-gradient(
                90deg,
                rgba(7, 17, 32, 0.95),
                rgba(7, 17, 32, 0.65),
                rgba(7, 17, 32, 0.25)
            ),
            url("https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1600&q=85")
            center / cover no-repeat;

        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .membership-hero-content {
        padding: 35px 40px;
        max-width: 700px;
        color: #ffffff;
    }

    .membership-label {
        display: block;

        margin-bottom: 8px;

        color: #4da3ff;

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 2px;
    }

    .membership-hero h1 {
        margin: 0 0 10px;

        font-size: 34px;
        font-weight: 800;
        line-height: 1.2;
    }

    .membership-hero p {
        margin: 0;

        max-width: 620px;

        color: #e5e7eb;

        font-size: 14px;
        line-height: 1.7;
    }

    /* =========================================
       INFORMATION CARDS
       ========================================= */

    .membership-info {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 18px;

        margin-bottom: 18px;
    }

    .membership-status-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 16px;
        margin-bottom: 24px;
        border: 1px solid #dde8ff;
        border-radius: 12px;
        background: linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.04);
    }

    .membership-status-note {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        color: #1f2937;
    }

    .membership-status-note strong {
        font-size: 14px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .membership-update-time {
        font-size: 12px;
        color: #475569;
        font-weight: 700;
    }

    .membership-info-card {
        padding: 20px;

        background: #ffffff;

        border: 1px solid #e5e7eb;
        border-radius: 15px;

        box-shadow:
            0 5px 18px rgba(0, 0, 0, 0.04);

        transition:
            transform .2s ease,
            box-shadow .2s ease;
    }

    .membership-info-card:hover {
        transform: translateY(-2px);

        box-shadow:
            0 9px 24px rgba(0, 0, 0, 0.07);
    }

    .membership-icon {
        width: 44px;
        height: 44px;

        margin-bottom: 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background: #edf6ff;

        color: #1683ff;

        font-size: 20px;
    }

    .membership-info-card h4 {
        margin: 0 0 6px;

        color: #111827;

        font-size: 15px;
        font-weight: 700;
    }

    .membership-info-card p {
        margin: 0;

        color: #64748b;

        font-size: 12px;
        line-height: 1.6;
    }

    /* =========================================
       MAIN PANEL
       ========================================= */

    .membership-page .panel {
        margin-bottom: 24px;

        padding: 25px;

        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 16px;

        box-shadow:
            0 5px 20px rgba(0, 0, 0, 0.045);
    }

    /* =========================================
       PANEL HEADER
       ========================================= */

    .membership-panel-head {
        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 20px;
    }

    .membership-title {
        display: flex;

        align-items: center;

        gap: 13px;
    }

    .membership-title-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #eff6ff;

        color: #1677df;

        font-size: 18px;
    }

    .membership-title h3 {
        margin: 0;

        color: #111827;

        font-size: 20px;
        font-weight: 750;
    }

    .membership-title p {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 12px;
    }

    /* =========================================
       REFRESH BUTTON
       ========================================= */

    .membership-refresh {
        min-height: 42px;

        padding: 0 18px;

        border: none;

        border-radius: 9px;

        background: #111827;

        color: #ffffff;

        font-family: inherit;

        font-size: 13px;
        font-weight: 600;

        cursor: pointer;

        transition:
            background .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    .membership-refresh:hover {
        background: #1f2937;

        transform: translateY(-1px);

        box-shadow:
            0 6px 15px rgba(0, 0, 0, .12);
    }

    /* =========================================
       API INFORMATION
       ========================================= */

    .api-status {
        display: flex;

        align-items: center;

        gap: 8px;

        margin-top: 5px;

        color: #64748b;

        font-size: 12px;
    }

    .api-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: #16a34a;

        box-shadow:
            0 0 0 3px rgba(22, 163, 74, .12);
    }

    /* =========================================
       TABLE WRAPPER
       ========================================= */

    .membership-table-wrapper {
        width: 100%;

        overflow-x: auto;

        border: 1px solid #e5e7eb;

        border-radius: 11px;
    }

    /* =========================================
       TABLE
       ========================================= */

    .membership-page table {
        width: 100%;

        border-collapse: collapse;

        background: #ffffff;
    }

    .membership-page table thead {
        background: #f8fafc;
    }

    .membership-page table th {
        padding: 15px;

        text-align: left;

        color: #475569;

        font-size: 12px;
        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: .4px;

        border-bottom: 1px solid #e5e7eb;

        white-space: nowrap;
    }

    .membership-page table td {
        padding: 15px;

        color: #475569;

        font-size: 13px;

        border-bottom: 1px solid #eef2f7;

        white-space: nowrap;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
    }

    .status-indicator.active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-indicator.expiring {
        background: #fef3c7;
        color: #b45309;
    }

    .status-indicator.expired {
        background: #fee2e2;
        color: #b91c1c;
    }

    .membership-page table tbody tr {
        transition: background .2s ease;
    }

    .membership-page table tbody tr:hover {
        background: #f8fbff;
    }

    .membership-page table tbody tr:last-child td {
        border-bottom: none;
    }

    /* =========================================
       ID BADGE
       ========================================= */

    .membership-page table td:first-child {
        color: #1677df;

        font-weight: 700;
    }

    /* =========================================
       PLAN BADGE
       ========================================= */

    .plan-badge {
        display: inline-flex;

        align-items: center;

        padding: 6px 11px;

        border-radius: 20px;

        background: #f3e8ff;

        color: #7e22ce;

        font-size: 12px;
        font-weight: 600;
    }

    /* =========================================
       DATE
       ========================================= */

    .membership-date {
        color: #475569;

        font-size: 13px;
    }

    /* =========================================
       EMPTY TABLE
       ========================================= */

    .membership-empty {
        padding: 45px 20px;

        text-align: center;

        color: #64748b;
    }

    .membership-empty-icon {
        width: 55px;
        height: 55px;

        margin: 0 auto 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #eff6ff;

        color: #2588ff;

        font-size: 23px;
    }

    .membership-empty h4 {
        margin: 0 0 5px;

        color: #334155;

        font-size: 16px;
    }

    .membership-empty p {
        margin: 0;

        font-size: 13px;
    }

    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 900px) {

        .membership-info {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .membership-hero h1 {
            font-size: 29px;
        }
    }

    @@media (max-width: 650px) {

        .membership-info {
            grid-template-columns: 1fr;
        }

        .membership-hero {
            min-height: 245px;
        }

        .membership-hero-content {
            padding: 25px;
        }

        .membership-hero h1 {
            font-size: 27px;
        }

        .membership-page .panel {
            padding: 18px;
        }

        .membership-panel-head {
            align-items: flex-start;

            flex-direction: column;
        }

        .membership-refresh {
            width: 100%;
        }
    }

</style>


<div class="membership-page">

    <!-- =========================================
         HERO
         ========================================= -->

    <div class="membership-hero">

        <div class="membership-hero-content">

            <span class="membership-label">
                COMFORT GYM MANAGEMENT SYSTEM
            </span>

            <h1>
                Membership Management
            </h1>

            <p>
                Manage gym membership plans, subscription periods,
                and member access from one centralized and
                professional management system.
            </p>

        </div>

    </div>


    <!-- =========================================
         INFORMATION CARDS
         ========================================= -->

    <div class="membership-info">

        <div class="membership-info-card">

            <div class="membership-icon">
                💳
            </div>

            <h4>
                Membership Plans
            </h4>

            <p>
                Keep track of the membership plans assigned
                to your gym members.
            </p>

        </div>


        <div class="membership-info-card">

            <div class="membership-icon">
                📅
            </div>

            <h4>
                Subscription Period
            </h4>

            <p>
                Monitor membership start and end dates
                for better membership management.
            </p>

        </div>


        <div class="membership-info-card">

            <div class="membership-icon">
                🏋️
            </div>

            <h4>
                Member Access
            </h4>

            <p>
                Keep membership records organized and
                support smooth gym operations.
            </p>

        </div>

    </div>

    <div class="membership-status-strip">
        <div class="membership-status-note">
            <span class="status-pill">Live overview</span>
            <strong id="membershipSummaryText">Loading membership overview...</strong>
        </div>
        <div class="membership-update-time" id="membershipLastUpdated">Updated just now</div>
    </div>


    <!-- =========================================
         MEMBERSHIP OVERVIEW
         ========================================= -->

    <div class="panel">

        <div class="membership-panel-head">

            <div class="membership-title">

                <div class="membership-title-icon">
                    💳
                </div>

                <div>

                    <h3>
                        Memberships
                    </h3>

                    <div class="api-status">

                        <span class="api-dot"></span>

                        Dynamic data connected to
                        <code>/api/memberships</code>

                    </div>

                </div>

            </div>


            <!--
                IMPORTANT:
                loadGeneric() is kept exactly
                like your original code.
            -->

            <button
                type="button"
                class="membership-refresh"
                onclick="loadGeneric()"
            >
                ↻ Refresh
            </button>

        </div>

    </div>


    <!-- =========================================
         MEMBERSHIP TABLE
         ========================================= -->

    <div class="panel">

        <div class="membership-table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>
                            ID
                        </th>

                        <th>
                            Member
                        </th>

                        <th>
                            Plan
                        </th>

                        <th>
                            Start
                        </th>

                        <th>
                            End
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <!--
                    IMPORTANT:
                    genericRows is kept exactly
                    like your original code.
                -->

                <tbody id="genericRows">

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    async function loadGeneric() {
        const rows = document.querySelector('#genericRows');
        if (!rows) return;

        try {
            const d = await api('/api/memberships');
            const list = Array.isArray(d) ? d : [];

            const summaryText = document.getElementById('membershipSummaryText');
            const updatedText = document.getElementById('membershipLastUpdated');

            if (summaryText) {
                summaryText.textContent = `${list.length} active memberships • ${list.length ? 'latest plans synced' : 'no plans recorded'}`;
            }
            if (updatedText) {
                updatedText.textContent = `Updated: ${new Date().toLocaleString()}`;
            }

            if (!list.length) {
                rows.innerHTML = `
                    <tr>
                        <td colspan="6">
                            <div class="membership-empty">
                                <div class="membership-empty-icon">📋</div>
                                <h4>No membership plans found</h4>
                                <p>Membership records will appear here once a member is assigned a plan.</p>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            rows.innerHTML = list.map(x => {
                const memberName = x.member?.fullName || x.memberId || 'Unknown member';
                const planName = x.membershipPlan?.name || x.membershipPlanId || 'Plan';
                const startDate = x.startDate ? new Date(x.startDate).toLocaleDateString() : '—';
                const endDate = x.endDate ? new Date(x.endDate).toLocaleDateString() : '—';

                let statusClass = 'active';
                let label = 'Active';
                if (x.member?.status === 'Expiring Soon') {
                    statusClass = 'expiring';
                    label = 'Expiring Soon';
                } else if (x.member?.status === 'Expired') {
                    statusClass = 'expired';
                    label = 'Expired';
                }

                return `
                    <tr>
                        <td>#${x.id}</td>
                        <td><strong>${esc(memberName)}</strong></td>
                        <td><span class="plan-badge">${esc(planName)}</span></td>
                        <td><span class="membership-date">${esc(startDate)}</span></td>
                        <td><span class="membership-date">${esc(endDate)}</span></td>
                        <td><span class="status-indicator ${statusClass}">${label}</span></td>
                    </tr>
                `;
            }).join('');
        } catch (err) {
            console.error(err);
            rows.innerHTML = `
                <tr>
                    <td colspan="6">
                        <div class="membership-empty">
                            <div class="membership-empty-icon">⚠️</div>
                            <h4>Unable to load memberships</h4>
                            <p>Please refresh the page or try again in a moment.</p>
                        </div>
                    </td>
                </tr>
            `;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadGeneric();
        setTimeout(loadGeneric, 400);
    });

</script>