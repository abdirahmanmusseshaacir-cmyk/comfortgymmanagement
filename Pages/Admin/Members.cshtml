<!-- =========================================================
     JAVASCRIPT LOGIC
     ========================================================= -->
<script>
let allMembers = [];
let currentFilter = 'all';
let currentSearch = '';
let activeMemberForRenew = null;

function initializeMemberPage() {
    initDefaultDates();
    loadMembers();
}

async function refreshMembersFromApi() {
    try {
        const response = await fetch('/api/members');
        if (!response.ok) throw new Error('Failed to load members');

        const members = await response.json();
        const list = Array.isArray(members) ? members : [];

        allMembers = list;
        window.allMembers = list;
        updateStats();
        renderMembersTable();
    } catch (err) {
        console.error(err);
        const tbody = document.getElementById('membersRows');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:30px; color:#dc2626;">Cilad ayaa dhacday soo gelinta xubnaha.</td></tr>';
        }
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        setupAmountPaidTracking();
        initDefaultDates();
        refreshMembersFromApi();
        setTimeout(refreshMembersFromApi, 400);
    });
} else {
    setupAmountPaidTracking();
    initDefaultDates();
    refreshMembersFromApi();
    setTimeout(refreshMembersFromApi, 400);
}

window.addEventListener('load', () => {
    setupAmountPaidTracking();
    refreshMembersFromApi();
});

function initDefaultDates() {
    const today = new Date();
    const todayStr = formatDateIso(today);
    const regInput = document.getElementById('registrationDate');
    if (regInput) {
        regInput.value = todayStr;
        calcExpiryDate();
    }
}

function calcExpiryDate() {
    const regInput = document.getElementById('registrationDate');
    const expInput = document.getElementById('expiryDate');
    const planSelect = document.getElementById('planSelect');
    if (!regInput || !expInput) return;

    const regDate = new Date(regInput.value || new Date());
    const selectedOption = planSelect?.selectedOptions[0];
    const durationDays = parseInt(selectedOption?.getAttribute('data-days') || '30', 10);

    const expDate = new Date(regDate);
    expDate.setDate(expDate.getDate() + durationDays);

    expInput.value = formatDateIso(expDate);
    expInput.min = regInput.value;
}

function handlePlanChange() {
    const planSelect = document.getElementById('planSelect');
    const amountInput = document.getElementById('amountPaid');
    if (planSelect && amountInput) {
        const price = planSelect.selectedOptions[0]?.getAttribute('data-price') || '30';
        const defaultValue = parseFloat(price).toFixed(2);

        if (amountInput.dataset.userEdited !== 'true') {
            amountInput.value = defaultValue;
        }
    }
    calcExpiryDate();
}

function setupAmountPaidTracking() {
    const amountInput = document.getElementById('amountPaid');
    if (!amountInput) return;

    amountInput.dataset.userEdited = 'false';
    amountInput.addEventListener('input', () => {
        amountInput.dataset.userEdited = 'true';
    });
    amountInput.addEventListener('focus', () => {
        if (amountInput.dataset.userEdited !== 'true') {
            amountInput.dataset.userEdited = 'true';
        }
    });
}

function formatDateIso(date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
}

async function loadMembers() {
    const tbody = document.getElementById('membersRows');
    if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="members-loading">Xogta xubnaha ayaa la soo gelinayaa...</td></tr>`;

    try {
        const res = await fetch('/api/members');
        if (!res.ok) throw new Error('Cilad ayaa dhacday xogta xubnaha.');

        const membersData = await res.json();
        allMembers = Array.isArray(membersData) ? membersData : [];
        window.allMembers = allMembers;

        if (!Array.isArray(allMembers)) {
            allMembers = [];
            window.allMembers = allMembers;
        }

        updateStats();
        renderMembersTable();
    } catch (err) {
        console.error(err);
        if (tbody) tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:30px; color:#dc2626;">Cilad ayaa dhacday soo gelinta xubnaha.</td></tr>`;
    }
}

function updateStats() {
    const membersList = Array.isArray(allMembers) ? allMembers : [];
    const total = membersList.length;
    const active = membersList.filter(m => m.status === 'Active').length;
    const soon = membersList.filter(m => m.status === 'Expiring Soon').length;
    const expired = membersList.filter(m => m.status === 'Expired').length;
    const activeIncludingSoon = active + soon;

    document.getElementById('statTotalMembers').textContent = total;
    document.getElementById('statActiveMembers').textContent = activeIncludingSoon;
    document.getElementById('statExpiringSoon').textContent = soon;
    document.getElementById('statExpiredMembers').textContent = expired;

    document.getElementById('countAll').textContent = total;
    document.getElementById('countActive').textContent = activeIncludingSoon;
    document.getElementById('countSoon').textContent = soon;
    document.getElementById('countExpired').textContent = expired;

    const summaryText = document.getElementById('memberSummaryText');
    const lastUpdated = document.getElementById('memberLastUpdated');
    if (summaryText) {
        summaryText.textContent = `${total} total members • ${active} active • ${soon} expiring soon • ${expired} expired`;
    }
    if (lastUpdated) {
        lastUpdated.textContent = `Updated: ${new Date().toLocaleString()}`;
    }
}

function filterMembers(status) {
    currentFilter = status;
    document.querySelectorAll('.ftab').forEach(t => {
        t.classList.toggle('active', t.getAttribute('data-filter') === status);
    });
    renderMembersTable();
}

function matchesStatusFilter(member, status) {
    if (status === 'Active') {
        return member.status === 'Active' || member.status === 'Expiring Soon';
    }

    if (status === 'Expired') {
        return member.status === 'Expired';
    }

    if (status === 'Expiring Soon') {
        return member.status === 'Expiring Soon';
    }

    return true;
}

function handleSearch(query) {
    currentSearch = (query || '').toLowerCase().trim();
    renderMembersTable();
}

function renderMembersTable() {
    const tbody = document.getElementById('membersRows');
    if (!tbody) return;

    let filtered = allMembers;

    if (currentFilter !== 'all') {
        filtered = filtered.filter(m => matchesStatusFilter(m, currentFilter));
    }

    if (currentSearch) {
        filtered = filtered.filter(m =>
            (m.fullName || '').toLowerCase().includes(currentSearch) ||
            (m.phone || '').toLowerCase().includes(currentSearch) ||
            (m.email || '').toLowerCase().includes(currentSearch) ||
            String(m.id).includes(currentSearch)
        );
    }

    if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:35px; color:#64748b;">Wax xubin ah laguma helin xaaladdan ama baaritaankan.</td></tr>`;
        return;
    }

    const currentUser = getCurrentGymUser();

    tbody.innerHTML = filtered.map(m => {
        let statusBadge = '';
        let daysBadge = '';
        const canManage = currentUser && (m.createdByUserId == null || Number(m.createdByUserId) === Number(currentUser.id));

        if (m.status === 'Active') {
            statusBadge = `<span class="status-badge active">● Shaqaynaya</span>`;
            daysBadge = `<span class="days-pill good">${m.daysLeft} Maalmood</span>`;
        } else if (m.status === 'Expiring Soon') {
            statusBadge = `<span class="status-badge soon">⏳ Dhawaan Dhacaya</span>`;
            daysBadge = `<span class="days-pill warning">${m.daysLeft} Maalmood</span>`;
        } else {
            statusBadge = `<span class="status-badge expired">⚠️ Wuu Dhacay</span>`;
            daysBadge = `<span class="days-pill danger">Dhacay (${Math.abs(m.daysLeft)}d)</span>`;
        }

        const editButton = canManage
            ? `<button type="button" class="btn-action renew" onclick="openEditMemberModal(${m.id})" title="Wax ka bedel">✏️ Edit</button>`
            : `<button type="button" class="btn-action renew" style="opacity:0.4; cursor:not-allowed;" title="Kaliya qofka diiwaangeliyey ayaa wax ka bedeli kara">✏️ Edit</button>`;

        const deleteButton = canManage
            ? `<button type="button" class="btn-action delete" onclick="deleteMember(${m.id})" title="Tirtir">🗑️</button>`
            : `<button type="button" class="btn-action delete" style="opacity:0.4; cursor:not-allowed;" title="Kaliya qofka diiwaangeliyey ayaa tirtiri kara">🗑️</button>`;

        return `
            <tr>
                <td><strong>#${m.id}</strong></td>
                <td>
                    <div style="font-weight:800; color:#0f172a;">${escapeHtml(m.fullName)}</div>
                    <small style="color:#64748b;">${escapeHtml(m.gender || 'Member')} • ${escapeHtml(m.address || '-')}</small>
                </td>
                <td>${escapeHtml(m.phone || '-')}</td>
                <td><span style="font-weight:700; color:#475569;">${escapeHtml(m.planName || 'Monthly Standard')}</span></td>
                <td><span class="date-pill blue">${m.registrationDate || '-'}</span></td>
                <td><span class="date-pill orange">${m.expiryDate || '-'}</span></td>
                <td>${daysBadge}</td>
                <td>${statusBadge}</td>
                <td>
                    <div class="action-btns">
                        <button type="button" class="btn-action renew" onclick="openRenewModal(${m.id})" title="Cusboonaysii Xubinnimada">🔄 Renew</button>
                        <button type="button" class="btn-action card" onclick="openCardModal(${m.id})" title="Arag Kaarka Xubinta">🪪 Kaar</button>
                        ${editButton}
                        ${deleteButton}
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

async function addMember(e) {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('addMemberButton');
    const msg = document.getElementById('memberMessage');

    const regDate = form.registrationDate.value;
    const expDate = form.expiryDate.value;

    if (expDate < regDate) {
        msg.textContent = 'Taariikhda dhicitaanku kama hor mari karto taariikhda la diiwaangeliyey!';
        msg.style.color = '#dc2626';
        return;
    }

    const currentUser = getCurrentGymUser();
    const payload = {
        fullName: form.fullName.value.trim(),
        phone: form.phone.value.trim(),
        email: form.email.value.trim() || null,
        gender: form.gender.value,
        address: form.address.value.trim(),
        registrationDate: regDate,
        expiryDate: expDate,
        membershipPlanId: parseInt(form.membershipPlanId.value, 10),
        emergencyContact: form.emergencyContact.value.trim(),
        notes: form.notes.value.trim(),
        createdByUserId: currentUser ? Number(currentUser.id) : null,
        createdByName: currentUser ? currentUser.fullName : 'System'
    };

    btn.disabled = true;
    btn.textContent = 'Diiwaangelinta ayaa socota...';
    msg.textContent = '';

    try {
        const res = await fetch('/api/members', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.message || 'Diiwaangelintu ma suuroobin.');
        }

        form.reset();
        const amountInput = document.getElementById('amountPaid');
        if (amountInput) {
            amountInput.dataset.userEdited = 'false';
        }
        initDefaultDates();
        handlePlanChange();

        msg.textContent = '✅ Xubinta si guul leh ayaa loo diiwaangeliyey oo loogu daray nidaamka!';
        msg.style.color = '#16a34a';

        await loadMembers();
    } catch (err) {
        console.error(err);
        msg.textContent = '❌ ' + err.message;
        msg.style.color = '#dc2626';
    } finally {
        btn.disabled = false;
        btn.textContent = '+ Diiwaangeli Xubinta (Register Member)';
    }
}

function getCurrentGymUser() {
    try {
        const raw = localStorage.getItem('gymUser');
        return raw ? JSON.parse(raw) : null;
    } catch {
        return null;
    }
}

function canManageMember(member) {
    const currentUser = getCurrentGymUser();
    if (!currentUser) return false;
    return member.createdByUserId == null || Number(member.createdByUserId) === Number(currentUser.id);
}

async function deleteMember(id) {
    const member = allMembers.find(x => x.id === id);
    if (!member) return;

    if (!canManageMember(member)) {
        alert('Kaliya qofka diiwaangeliyey ayaa tirtiri kara xubintan.');
        return;
    }

    if (!confirm(`Ma hubtaa inaad tirtirto xubinta #${id}?`)) return;

    const currentUser = getCurrentGymUser();
    try {
        const res = await fetch(`/api/members/${id}?requestedByUserId=${currentUser ? currentUser.id : ''}`, { method: 'DELETE' });
        if (!res.ok) {
            const text = await res.text();
            throw new Error(text || 'Lama tirtiri karin xubinta.');
        }
        await loadMembers();
    } catch (err) {
        alert(err.message || 'Lama tirtiri karin xubinta.');
    }
}

function openEditMemberModal(id) {
    const m = allMembers.find(x => x.id === id);
    if (!m) return;
    if (!canManageMember(m)) {
        alert('Kaliya qofka diiwaangeliyey ayaa wax ka bedeli kara xubintan.');
        return;
    }

    const currentUser = getCurrentGymUser();
    document.getElementById('editMemberId').value = m.id;
    document.getElementById('editRequestedByUserId').value = currentUser ? currentUser.id : '';
    document.getElementById('editMemberName').textContent = `${m.fullName}`;
    document.getElementById('editRegisteredBy').textContent = m.createdByName || 'System';
    document.getElementById('editFullName').value = m.fullName || '';
    document.getElementById('editPhone').value = m.phone || '';
    document.getElementById('editEmail').value = m.email || '';
    document.getElementById('editGender').value = m.gender || 'Male';
    document.getElementById('editAddress').value = m.address || '';
    document.getElementById('editRegistrationDate').value = m.registrationDate || '';
    document.getElementById('editExpiryDate').value = m.expiryDate || '';
    document.getElementById('editEmergencyContact').value = m.emergencyContact || '';
    document.getElementById('editNotes').value = m.notes || '';
    document.getElementById('editMemberMessage').textContent = '';
    document.getElementById('editMemberModal').classList.add('active');
}

function closeEditMemberModal() {
    document.getElementById('editMemberModal').classList.remove('active');
}

async function submitMemberEdit(e) {
    e.preventDefault();
    const id = Number(document.getElementById('editMemberId').value);
    const currentUser = getCurrentGymUser();
    const form = document.getElementById('editMemberForm');
    const msg = document.getElementById('editMemberMessage');

    if (!currentUser) {
        msg.textContent = 'Fadlan gal login-ka hore si aad wax uga bedesho.';
        msg.style.color = '#dc2626';
        return;
    }

    const payload = {
        fullName: document.getElementById('editFullName').value.trim(),
        email: document.getElementById('editEmail').value.trim() || null,
        phone: document.getElementById('editPhone').value.trim(),
        gender: document.getElementById('editGender').value,
        address: document.getElementById('editAddress').value.trim(),
        registrationDate: document.getElementById('editRegistrationDate').value || null,
        expiryDate: document.getElementById('editExpiryDate').value || null,
        emergencyContact: document.getElementById('editEmergencyContact').value.trim(),
        notes: document.getElementById('editNotes').value.trim(),
        requestedByUserId: Number(currentUser.id)
    };

    try {
        const res = await fetch(`/api/members/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (!res.ok) {
            const errText = await res.text();
            throw new Error(errText || 'Wax ka bedelka ma guuleysan');
        }

        msg.textContent = '✅ Wax ka bedelka si guul leh ayaa la dhammaystiray.';
        msg.style.color = '#16a34a';
        setTimeout(() => {
            closeEditMemberModal();
            loadMembers();
        }, 800);
    } catch (err) {
        msg.textContent = '❌ ' + (err.message || 'Wax ka bedelka ma guuleysan');
        msg.style.color = '#dc2626';
    }
}

/* RENEWAL MODAL FUNCTIONS */
function openRenewModal(id) {
    const m = allMembers.find(x => x.id === id);
    if (!m) return;
    activeMemberForRenew = m;

    document.getElementById('renewMemberId').value = m.id;
    document.getElementById('renewMemberName').textContent = `#${m.id} - ${m.fullName}`;
    document.getElementById('renewCurrentExpiry').textContent = m.expiryDate || 'Lama hayo';
    document.getElementById('renewDuration').value = '30';
    document.getElementById('renewAmount').value = '30.00';
    document.getElementById('renewMsg').textContent = '';

    updateRenewPreview();
    document.getElementById('renewModal').classList.add('active');
}

function closeRenewModal() {
    document.getElementById('renewModal').classList.remove('active');
    activeMemberForRenew = null;
}

function updateRenewPreview() {
    if (!activeMemberForRenew) return;
    const durSelect = document.getElementById('renewDuration');
    const days = parseInt(durSelect.value, 10);
    const amount = durSelect.selectedOptions[0]?.getAttribute('data-amount') || '30.00';
    document.getElementById('renewAmount').value = parseFloat(amount).toFixed(2);

    const today = new Date();
    const curExp = activeMemberForRenew.expiryDate ? new Date(activeMemberForRenew.expiryDate) : today;
    const base = curExp > today ? curExp : today;

    const newExp = new Date(base);
    newExp.setDate(newExp.getDate() + days);

    document.getElementById('renewNewExpiryPreview').textContent = `📅 Taariikhda Cusub: ${formatDateIso(newExp)} (+${days} Maalmood)`;
}

async function submitRenewal(e) {
    e.preventDefault();
    if (!activeMemberForRenew) return;

    const btn = document.getElementById('renewSubmitBtn');
    const msg = document.getElementById('renewMsg');
    const days = parseInt(document.getElementById('renewDuration').value, 10);
    const amount = parseFloat(document.getElementById('renewAmount').value) || 0;
    const method = document.getElementById('renewPaymentMethod').value;
    const notes = document.getElementById('renewNotes').value;

    btn.disabled = true;
    btn.textContent = 'Cusboonaysiinta ayaa socota...';

    try {
        const res = await fetch(`/api/members/${activeMemberForRenew.id}/renew`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                durationDays: days,
                amount: amount,
                paymentMethod: method,
                notes: notes
            })
        });

        if (!res.ok) throw new Error('Cusboonaysiintu ma suuroobin.');

        const result = await res.json();
        msg.textContent = `✅ ${result.message}`;
        msg.style.color = '#16a34a';

        setTimeout(() => {
            closeRenewModal();
            loadMembers();
        }, 1200);
    } catch (err) {
        msg.textContent = '❌ ' + err.message;
        msg.style.color = '#dc2626';
    } finally {
        btn.disabled = false;
        btn.textContent = '🔄 Xaqiiji Cusboonaysiinta (Confirm Renewal)';
    }
}

/* CARD MODAL FUNCTIONS */
function openCardModal(id) {
    const m = allMembers.find(x => x.id === id);
    if (!m) return;

    document.getElementById('cardName').textContent = m.fullName;
    document.getElementById('cardId').textContent = `CG-${String(m.id).padStart(4, '0')}`;
    document.getElementById('cardPhone').textContent = m.phone || '-';
    document.getElementById('cardRegDate').textContent = m.registrationDate || '-';
    document.getElementById('cardExpDate').textContent = m.expiryDate || '-';
    document.getElementById('cardStatus').textContent = m.status === 'Active' ? '🟢 Active' : (m.status === 'Expiring Soon' ? '🟡 Expiring Soon' : '🔴 Expired');

    document.getElementById('cardModal').classList.add('active');
}

function closeCardModal() {
    document.getElementById('cardModal').classList.remove('active');
}

function escapeHtml(str) {
    return String(str ?? '').replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    })[m]);
}
</script>