@page
@{
    ViewData["Title"] = "Reports";
}

<style>
    .reports-page {
        width: 100%;
        box-sizing: border-box;
    }

    .reports-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .reports-title {
        margin: 0;
        color: #0f172a;
        font-size: 28px;
        font-weight: 800;
    }

    .report-print-btn {
        border: none;
        border-radius: 10px;
        background: #0f172a;
        color: #ffffff;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .report-print-btn:hover {
        opacity: 0.95;
    }

    .activity-panel {
        padding: 20px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .activity-table-wrap {
        overflow-x: auto;
    }

    .activity-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .activity-table th,
    .activity-table td {
        padding: 12px 10px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
        vertical-align: top;
    }

    .activity-table th {
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .activity-table td {
        color: #334155;
    }

    .activity-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-registration {
        background: #ecfdf5;
        color: #15803d;
    }

    .badge-payment {
        background: #eff6ff;
        color: #1d4ed8;
    }

    @@media print {
        body {
            background: #ffffff !important;
        }

        .sidebar,
        .topbar,
        .reports-toolbar,
        .report-print-btn {
            display: none !important;
        }

        .main {
            margin-left: 0 !important;
            width: 100% !important;
        }

        .content {
            padding: 0 !important;
        }

        .reports-page {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .activity-panel {
            display: block !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: #ffffff !important;
        }

        .activity-table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 11px !important;
        }

        .activity-table th,
        .activity-table td {
            padding: 8px 6px !important;
            border: 1px solid #dfe5ec !important;
        }
    }
</style>


<div class="reports-page">
    <div class="reports-toolbar">
        <h1 class="reports-title">Recent Transactions</h1>
        <button type="button" class="report-print-btn" onclick="printRecentTransactions()">
            Print
        </button>
    </div>

    <div class="activity-panel">
        <div class="activity-table-wrap">
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Member</th>
                        <th>Details</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody id="reportActivityRows">
                    <tr>
                        <td colspan="5">Loading transactions...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function printRecentTransactions() {
        const rowsContainer = document.getElementById('reportActivityRows');
        if (!rowsContainer) return;

        const rowsHtml = rowsContainer.innerHTML;
        const printWindow = window.open('', '_blank', 'width=900,height=700');
        if (!printWindow) {
            alert('Your browser blocked the print window. Please allow pop-ups and try again.');
            return;
        }

        const printHtml = `
            <html>
                <head>
                    <title>Recent Transactions</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 20px; color: #111827; }
                        h2 { margin: 0 0 12px; font-size: 24px; }
                        table { width: 100%; border-collapse: collapse; font-size: 12px; }
                        th, td { border: 1px solid #dfe5ec; padding: 8px 6px; text-align: left; vertical-align: top; }
                        th { background: #f8fafc; }
                        .activity-badge { display: inline-block; padding: 5px 8px; border-radius: 999px; font-weight: 700; font-size: 10px; }
                        .badge-registration { background: #ecfdf5; color: #15803d; }
                        .badge-payment { background: #eff6ff; color: #1d4ed8; }
                    </style>
                </head>
                <body>
                    <h2>Recent Transactions</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Member</th>
                                <th>Details</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                    </table>
                </body>
            </html>
        `;

        printWindow.document.write(printHtml);
        printWindow.document.close();
        printWindow.focus();
        printWindow.print();
        printWindow.close();
    }

    async function loadReportData() {
        try {
            const [membersRes, paymentsRes] = await Promise.all([
                fetch('/api/members'),
                fetch('/api/payments')
            ]);

            if (!membersRes.ok || !paymentsRes.ok) {
                throw new Error('Unable to load reporting data.');
            }

            const members = await membersRes.json();
            const payments = await paymentsRes.json();

            const activityRows = [];

            if (Array.isArray(members)) {
                members.slice(0, 8).forEach(member => {
                    activityRows.push({
                        date: member.registrationDate || member.createdAt || member.updatedAt || new Date().toISOString(),
                        type: 'Registration',
                        member: member.fullName || member.name || 'Unknown member',
                        details: member.membershipPlanName || 'New member registration',
                        amount: '—'
                    });
                });
            }

            if (Array.isArray(payments)) {
                payments.slice(0, 8).forEach(payment => {
                    activityRows.push({
                        date: payment.paymentDate || payment.createdAt || payment.date || new Date().toISOString(),
                        type: 'Payment',
                        member: payment.member?.fullName || payment.memberName || 'Unknown member',
                        details: payment.notes || payment.invoiceNumber || 'Membership payment',
                        amount: `$${Number(payment.amount || 0).toFixed(2)}`
                    });
                });
            }

            const rowsContainer = document.getElementById('reportActivityRows');
            if (!rowsContainer) return;

            rowsContainer.innerHTML = '';

            if (!activityRows.length) {
                rowsContainer.innerHTML = '<tr><td colspan="5">No recent transactions available.</td></tr>';
                return;
            }

            activityRows
                .sort((a, b) => new Date(b.date) - new Date(a.date))
                .slice(0, 12)
                .forEach(item => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${new Date(item.date).toLocaleString()}</td>
                        <td><span class="activity-badge ${item.type === 'Payment' ? 'badge-payment' : 'badge-registration'}">${item.type}</span></td>
                        <td>${item.member}</td>
                        <td>${item.details}</td>
                        <td>${item.amount}</td>
                    `;
                    rowsContainer.appendChild(row);
                });
        }
        catch (error) {
            console.error('Error loading report data:', error);
            const rowsContainer = document.getElementById('reportActivityRows');
            if (rowsContainer) {
                rowsContainer.innerHTML = '<tr><td colspan="5">Unable to load report transactions.</td></tr>';
            }
        }
    }

    document.addEventListener('DOMContentLoaded', loadReportData);
</script>

