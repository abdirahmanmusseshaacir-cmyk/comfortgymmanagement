@page
@{
    ViewData["Title"] = "Classes";
}

<div class="classes-page">

    <!-- HERO -->
    <section class="classes-hero">

        <div class="classes-hero-overlay"></div>

        <div class="classes-hero-content">

            <span class="classes-label">
                COMFORT GYM MANAGEMENT SYSTEM
            </span>

            <h1>
                Fitness Classes
            </h1>

            <p>
                Manage gym classes, trainers, schedules and capacity
                to provide members with an organized and effective
                fitness experience.
            </p>

            <div class="hero-actions">

                <button type="button"
                        class="add-class-btn"
                        onclick="openAddClassModal()">

                    <span>ï¼‹</span>
                    Add New Class

                </button>

                <button type="button"
                        class="refresh-class-btn"
                        onclick="loadClasses()">

                    â†» Refresh

                </button>

            </div>

        </div>

    </section>


    <!-- INFORMATION CARDS -->
    <section class="class-info-section">

        <div class="class-info-card" data-card="schedule" tabindex="0" role="button" aria-label="Open class scheduling details">

            <div class="class-info-image">
                <div class="class-card-overlay"></div>
                <img src="/images/class-scheduling.svg"
                     alt="Class Scheduling">
            </div>

            <div class="class-info-content">

                <div class="info-header-row">
                    <span class="info-number">01</span>
                    <span class="info-badge"><span class="info-badge-icon">ðŸ“…</span> Live</span>
                </div>

                <h4>
                    Class Scheduling
                </h4>

                <p id="classScheduleSummary">
                    Loading schedule information...
                </p>

            </div>

        </div>


        <div class="class-info-card" data-card="trainer" tabindex="0" role="button" aria-label="Open trainer details">

            <div class="class-info-image image-trainer">
                <div class="class-card-overlay"></div>
                <img src="/images/professional-trainer.svg"
                     alt="Professional Trainer">
            </div>

            <div class="class-info-content">

                <div class="info-header-row">
                    <span class="info-number">02</span>
                    <span class="info-badge badge-trainer"><span class="info-badge-icon">ðŸ‘¨â€ðŸ«</span> Active</span>
                </div>

                <h4>
                    Professional Trainers
                </h4>

                <p id="trainerSummary">
                    Loading trainer information...
                </p>

            </div>

        </div>

    </section>


    <!-- MANAGEMENT PANEL -->
    <section class="class-management-panel">

        <div class="class-panel-header">

            <div class="class-panel-title">

                <div class="class-panel-icon">
                    âœ“
                </div>

                <div>

                    <h3>
                        Class Management
                    </h3>

                    <p>
                        View and manage all registered fitness classes.
                    </p>

                </div>

            </div>


            <div class="panel-actions">

                <button type="button"
                        class="class-refresh-btn"
                        onclick="loadClasses()">

                    â†» Refresh Classes

                </button>

                <button type="button"
                        class="class-add-btn"
                        onclick="openAddClassModal()">

                    ï¼‹ Add Class

                </button>

            </div>

        </div>


        <!-- TABLE -->
        <div class="class-table-container">

            <div class="class-table-header">

                <div>

                    <h3>
                        Class Directory
                    </h3>

                    <p>
                        Registered fitness classes and their schedules
                    </p>

                </div>

                <div class="class-status">

                    <span class="status-dot"></span>

                    Live Data

                </div>

            </div>


            <div class="class-table-wrapper">

                <table class="classes-table">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Class Name</th>

                            <th>Trainer</th>

                            <th>Schedule</th>

                            <th>Capacity</th>

                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody id="genericRows">

                        <tr>

                            <td colspan="6"
                                class="class-loading">

                                Loading classes...

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</div>

<div id="classDetailPopup" class="detail-popup" aria-modal="true" role="dialog">
    <div class="detail-popup-card">
        <div class="detail-popup-header">
            <div class="detail-popup-heading">
                <span class="detail-popup-icon" id="classDetailIcon">ðŸ“‹</span>
                <h3 id="classDetailTitle">Details</h3>
            </div>
            <button type="button" id="classDetailClose" class="detail-popup-close" aria-label="Close details">Ã—</button>
        </div>
        <div class="detail-popup-body" id="classDetailBody"></div>
    </div>
</div>

<!-- ADD CLASS MODAL -->
<div id="addClassModal"
     class="class-modal">

    <div class="class-modal-overlay"
         onclick="closeAddClassModal()">
    </div>


    <div class="class-modal-box">

        <div class="class-modal-header">

            <div>

                <span>
                    COMFORT GYM
                </span>

                <h2>
                    Add New Class
                </h2>

                <p>
                    Create a new fitness class and assign a trainer.
                </p>

            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeAddClassModal()">

                Ã—

            </button>

        </div>


        <form id="addClassForm"
              onsubmit="addClass(event)">

            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Class Name
                    </label>

                    <input type="text"
                           id="className"
                           name="className"
                           placeholder="e.g. Yoga"
                           required>

                </div>


                <div class="form-group">

                    <label>
                        Trainer
                    </label>

                    <select id="trainer" name="trainer">
                        <option value="">Select Trainer...</option>
                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Time
                    </label>

                    <input type="time"
                           id="classTime"
                           name="classTime"
                           required>

                </div>


                <div class="form-group">

                    <label>
                        Capacity
                    </label>

                    <input type="number"
                           id="capacity"
                           name="capacity"
                           placeholder="e.g. 20"
                           min="1"
                           required>

                </div>


                <div class="form-group">

                    <label>
                        Session Type
                    </label>

                    <select id="classType"
                            name="classType">

                        <option value="Morning">
                            Morning
                        </option>

                        <option value="Afternoon">
                            Afternoon
                        </option>

                        <option value="Evening">
                            Evening
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label>
                        Start Time
                    </label>

                    <select id="startTime"
                            name="startTime">
                        <option value="08:00 AM">08:00 AM</option>
                        <option value="09:00 AM">09:00 AM</option>
                        <option value="10:00 AM">10:00 AM</option>
                        <option value="11:00 AM">11:00 AM</option>
                        <option value="12:00 PM">12:00 PM</option>
                        <option value="01:00 PM">01:00 PM</option>
                        <option value="02:00 PM">02:00 PM</option>
                        <option value="03:00 PM">03:00 PM</option>
                        <option value="04:00 PM">04:00 PM</option>
                        <option value="05:00 PM">05:00 PM</option>
                        <option value="06:00 PM">06:00 PM</option>
                        <option value="07:00 PM">07:00 PM</option>
                        <option value="08:00 PM">08:00 PM</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        End Time
                    </label>

                    <select id="endTime"
                            name="endTime">
                        <option value="10:00 AM">10:00 AM</option>
                        <option value="11:00 AM">11:00 AM</option>
                        <option value="12:00 PM">12:00 PM</option>
                        <option value="01:00 PM">01:00 PM</option>
                        <option value="02:00 PM">02:00 PM</option>
                        <option value="03:00 PM">03:00 PM</option>
                        <option value="04:00 PM">04:00 PM</option>
                        <option value="05:00 PM">05:00 PM</option>
                        <option value="06:00 PM">06:00 PM</option>
                        <option value="07:00 PM">07:00 PM</option>
                        <option value="08:00 PM">08:00 PM</option>
                        <option value="09:00 PM">09:00 PM</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select id="classStatus"
                            name="classStatus">

                        <option value="Pending" selected>
                            Pending
                        </option>

                        <option value="Active">
                            Active
                        </option>

                        <option value="Inactive">
                            Inactive
                        </option>

                    </select>

                </div>

            </div>


            <div id="classMessage"
                 class="class-message">
            </div>


            <div class="modal-form-actions">

                <button type="button"
                        class="cancel-btn"
                        onclick="closeAddClassModal()">

                    Cancel

                </button>

                <button type="submit"
                        class="save-class-btn">

                    <span>ï¼‹</span>
                    Save Class

                </button>

            </div>

        </form>

    </div>

</div>

<!-- EDIT CLASS MODAL -->
<div id="editClassModal"
     class="class-modal">

    <div class="class-modal-overlay"
         onclick="closeEditClassModal()">
    </div>

    <div class="class-modal-box">

        <div class="class-modal-header">

            <div>

                <span>
                    COMFORT GYM
                </span>

                <h2>
                    Edit Class
                </h2>

                <p>
                    Update class details, schedule and trainer assignment.
                </p>

            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeEditClassModal()">

                Ã—

            </button>

        </div>

        <form id="editClassForm"
              onsubmit="saveClassEdits(event)">

            <input type="hidden" id="editClassId" name="editClassId">

            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Class Name
                    </label>

                    <input type="text"
                           id="editClassName"
                           name="editClassName"
                           placeholder="e.g. Yoga"
                           required>

                </div>

                <div class="form-group">

                    <label>
                        Trainer
                    </label>

                    <select id="editTrainer" name="editTrainer">
                        <option value="">Select Trainer...</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        Session Type
                    </label>

                    <select id="editClassType"
                            name="editClassType">

                        <option value="Morning">Morning</option>
                        <option value="Afternoon">Afternoon</option>
                        <option value="Evening">Evening</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        Start Time
                    </label>

                    <select id="editStartTime"
                            name="editStartTime">
                        <option value="08:00 AM">08:00 AM</option>
                        <option value="09:00 AM">09:00 AM</option>
                        <option value="10:00 AM">10:00 AM</option>
                        <option value="11:00 AM">11:00 AM</option>
                        <option value="12:00 PM">12:00 PM</option>
                        <option value="01:00 PM">01:00 PM</option>
                        <option value="02:00 PM">02:00 PM</option>
                        <option value="03:00 PM">03:00 PM</option>
                        <option value="04:00 PM">04:00 PM</option>
                        <option value="05:00 PM">05:00 PM</option>
                        <option value="06:00 PM">06:00 PM</option>
                        <option value="07:00 PM">07:00 PM</option>
                        <option value="08:00 PM">08:00 PM</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        End Time
                    </label>

                    <select id="editEndTime"
                            name="editEndTime">
                        <option value="10:00 AM">10:00 AM</option>
                        <option value="11:00 AM">11:00 AM</option>
                        <option value="12:00 PM">12:00 PM</option>
                        <option value="01:00 PM">01:00 PM</option>
                        <option value="02:00 PM">02:00 PM</option>
                        <option value="03:00 PM">03:00 PM</option>
                        <option value="04:00 PM">04:00 PM</option>
                        <option value="05:00 PM">05:00 PM</option>
                        <option value="06:00 PM">06:00 PM</option>
                        <option value="07:00 PM">07:00 PM</option>
                        <option value="08:00 PM">08:00 PM</option>
                        <option value="09:00 PM">09:00 PM</option>
                    </select>

                </div>

                <div class="form-group">

                    <label>
                        Capacity
                    </label>

                    <input type="number"
                           id="editCapacity"
                           name="editCapacity"
                           placeholder="e.g. 20"
                           min="1"
                           required>

                </div>

                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select id="editClassStatus"
                            name="editClassStatus">

                        <option value="Pending">Pending</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                </div>

            </div>

            <div id="editClassMessage"
                 class="class-message">
            </div>

            <div class="modal-form-actions">

                <button type="button"
                        class="cancel-btn"
                        onclick="closeEditClassModal()">

                    Cancel

                </button>

                <button type="submit"
                        class="save-class-btn">

                    <span>âœ“</span>
                    Update Class

                </button>

            </div>

        </form>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    .classes-page {
        width: 100%;
        padding-bottom: 50px;
        background: #f5f7fa;
    }


    /* HERO */

    .classes-hero {
        position: relative;
        min-height: 390px;
        display: flex;
        align-items: center;
        overflow: hidden;

        background-image:
            url('/images/gym-classes-hero.svg');

        background-size: cover;
        background-position: center;
    }

    .classes-hero-overlay {
        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                90deg,
                rgba(7, 15, 27, .92),
                rgba(7, 15, 27, .65),
                rgba(7, 15, 27, .25)
            );
    }

    .classes-hero-content {
        position: relative;
        z-index: 2;

        max-width: 850px;
        padding: 70px 7%;
        color: white;
    }

    .classes-label {
        display: inline-block;

        padding: 8px 15px;
        margin-bottom: 18px;

        border: 1px solid rgba(255,255,255,.35);
        border-radius: 30px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .classes-hero h1 {
        margin: 0 0 15px;

        font-size: 52px;
        font-weight: 800;
        line-height: 1.1;
    }

    .classes-hero p {
        max-width: 650px;

        margin: 0;

        color: rgba(255,255,255,.85);

        font-size: 17px;
        line-height: 1.8;
    }


    /* HERO BUTTONS */

    .hero-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .add-class-btn,
    .refresh-class-btn {
        border: none;
        border-radius: 9px;

        padding: 13px 20px;

        font-size: 14px;
        font-weight: 700;

        cursor: pointer;

        transition: .25s;
    }

    .add-class-btn {
        background: #1d3557;
        color: white;
    }

    .add-class-btn:hover {
        background: #0d2349;
        transform: translateY(-2px);
    }

    .refresh-class-btn {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.3);
        color: white;
    }

    .refresh-class-btn:hover {
        background: rgba(255,255,255,.2);
    }


    /* INFO CARDS */

    .class-info-section {
        display: grid;

        grid-template-columns: repeat(2, minmax(280px, 1fr));

        gap: 22px;

        padding: 35px 7%;
    }

    .class-info-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;

        background: linear-gradient(180deg, #ffffff 0%, #fffaf7 100%);

        border-radius: 18px;

        border: 1px solid #edf0f5;

        box-shadow:
            0 14px 35px rgba(15, 23, 42, .08);

        transition: .3s ease;
        cursor: pointer;
    }

    .class-info-card:hover {
        transform: translateY(-6px);

        box-shadow:
            0 18px 40px rgba(15, 23, 42, .12);
    }

    .class-info-card:focus-visible {
        outline: 3px solid rgba(255, 107, 53, 0.32);
        outline-offset: 2px;
    }

    .class-info-image {
        position: relative;
        height: 180px;
        overflow: hidden;
        background: linear-gradient(135deg, #fff1eb 0%, #ffe7dc 100%);
    }

    .class-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(15,23,42,0.15));
    }

    .class-info-image img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;

        object-fit: cover;

        transition: .4s;
    }

    .class-info-card:hover
    .class-info-image img {
        transform: scale(1.06);
    }

    .class-info-content {
        padding: 22px 22px 24px;
    }

    .info-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .info-number {
        color: #1d3557;

        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1.5px;
    }

    .info-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #15803d;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-trainer {
        background: #eef2ff;
        color: #4338ca;
    }

    .info-badge-icon {
        font-size: 12px;
    }

    .class-info-content h4 {
        margin: 0 0 10px;

        font-size: 22px;
        line-height: 1.2;

        color: #182230;
    }

    .class-info-content p {
        margin: 0;

        color: #5f6c7a;

        font-size: 14px;
        line-height: 1.7;
    }


    /* MANAGEMENT */

    .class-management-panel {
        margin: 0 7%;

        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 16px;

        box-shadow:
            0 10px 30px rgba(15, 23, 42, .06);

        overflow: hidden;
    }

    .class-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 25px 28px;

        border-bottom: 1px solid #edf0f4;
    }

    .class-panel-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .class-panel-icon {
        width: 46px;
        height: 46px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        background: #fff1eb;

        color: #1d3557;

        font-size: 22px;
        font-weight: 800;
    }

    .class-panel-title h3 {
        margin: 0 0 4px;

        color: #172033;

        font-size: 20px;
    }

    .class-panel-title p {
        margin: 0;

        color: #8a93a3;

        font-size: 13px;
    }

    .panel-actions {
        display: flex;
        gap: 10px;
    }

    .class-refresh-btn,
    .class-add-btn {
        border: none;

        padding: 11px 16px;

        border-radius: 8px;

        cursor: pointer;

        font-size: 13px;
        font-weight: 700;
    }

    .class-refresh-btn {
        background: #f1f3f6;
        color: #384152;
    }

    .class-add-btn {
        background: #1d3557;
        color: white;
    }

    .class-add-btn:hover {
        background: #0d2349;
    }


    /* TABLE */

    .class-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 25px 28px 18px;
    }

    .class-table-header h3 {
        margin: 0 0 5px;

        color: #1c2636;
    }

    .class-table-header p {
        margin: 0;

        color: #8992a3;

        font-size: 13px;
    }

    .class-status {
        display: flex;
        align-items: center;
        gap: 7px;

        padding: 8px 12px;

        border-radius: 30px;

        background: #ecfdf3;

        color: #18864b;

        font-size: 12px;
        font-weight: 700;
    }

    .detail-popup {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        z-index: 9999;
    }

    .detail-popup.active {
        display: flex;
    }

    .detail-popup-card {
        width: min(680px, 100%);
        max-height: 80vh;
        overflow-y: auto;
        background: white;
        border-radius: 18px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.25);
        padding: 0;
    }

    .detail-popup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f4;
    }

    .detail-popup-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .detail-popup-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #fff1eb 0%, #ffe4d6 100%);
        color: #1d3557;
        font-size: 20px;
        box-shadow: inset 0 0 0 1px rgba(255, 107, 53, 0.08);
    }

    .detail-popup-header h3 {
        margin: 0;
        color: #172033;
        font-size: 22px;
    }

    .detail-popup-close {
        border: none;
        background: #f2f4f7;
        color: #475467;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        font-size: 24px;
        cursor: pointer;
    }

    .detail-popup-body {
        padding: 20px 24px 24px;
    }

    .detail-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 14px;
    }

    .detail-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border: 1px solid #edf0f4;
        border-radius: 14px;
        padding: 16px;
        color: #374151;
        line-height: 1.8;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.03);
    }

    .detail-item-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4338ca;
        font-size: 18px;
        box-shadow: inset 0 0 0 1px rgba(67, 56, 202, 0.05);
    }

    .detail-item-copy {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 100%;
    }

    .detail-list strong {
        color: #1f2937;
        font-size: 15px;
    }

    .detail-list span {
        display: block;
