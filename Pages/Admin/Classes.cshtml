</style>


<script>

    const classDataCache = [];
    const trainerDataCache = [];

    function bindInfoCards() {
        document.querySelectorAll(".class-info-card").forEach(card => {
            const type = card.dataset.card;
            if (!type) return;

            card.addEventListener("click", () => openDetailPopup(type));
            card.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    openDetailPopup(type);
                }
            });
        });
    }

    async function loadDetailData() {
        try {
            const [classesResponse, trainersResponse] = await Promise.all([
                fetch("/api/classes"),
                fetch("/api/trainers")
            ]);

            if (classesResponse.ok) {
                const classes = await classesResponse.json();
                classDataCache.splice(0, classDataCache.length, ...classes);
            }

            if (trainersResponse.ok) {
                const trainers = await trainersResponse.json();
                trainerDataCache.splice(0, trainerDataCache.length, ...trainers);
            }
        }
        catch (error) {
            console.error(error);
        }
    }

    function openDetailPopup(type) {
        const popup = document.getElementById("classDetailPopup");
        const title = document.getElementById("classDetailTitle");
        const body = document.getElementById("classDetailBody");
        const icon = document.getElementById("classDetailIcon");

        if (!popup || !title || !body || !icon) return;

        if (type === "schedule") {
            title.textContent = "Class Scheduling Details";
            icon.textContent = "ðŸ“…";

            const items = classDataCache.length
                ? classDataCache
                : [{ name: "No class data available yet", scheduleDate: "", trainer: { fullName: "Please refresh the page" }, capacity: 0 }];

            body.innerHTML = `
                <ul class="detail-list">
                    ${items.map(item => {
                        const name = item.name || item.className || "Untitled Class";
                        const sessionType = item.sessionType || item.description || "Morning";
                        const trainer = item.trainer?.fullName || item.trainerName || "Trainer not assigned";
                        const capacity = Number(item.capacity) || 0;
                        const timeRange = (item.startTime || item.start) && (item.endTime || item.end)
                            ? `${item.startTime || item.start} - ${item.endTime || item.end}`
                            : (item.startTime || item.start || item.classTime || item.time || "Schedule not set");

                        return `
                            <li>
                                <span class="detail-item-icon">ðŸ—“ï¸</span>
                                <div class="detail-item-copy">
                                    <strong>${escapeHtml(name)}</strong>
                                    <span>ðŸ… Session: ${escapeHtml(sessionType)}</span>
                                    <span>ðŸ’¡ Time: ${escapeHtml(timeRange)}</span>
                                    <span>ðŸ‘¨â€ðŸ« Trainer: ${escapeHtml(trainer)}</span>
                                    <span>ðŸ‘¥ Capacity: ${capacity} members</span>
                                </div>
                            </li>
                        `;
                    }).join("")}
                </ul>
            `;
        }
        else {
            title.textContent = "Professional Trainer Details";
            icon.textContent = "ðŸ‘¨â€ðŸ«";

            const items = trainerDataCache.length
                ? trainerDataCache
                : [{ fullName: "No trainer data available yet", specialization: "General Fitness", email: "Not available", phone: "Not available" }];

            body.innerHTML = `
                <ul class="detail-list">
                    ${items.map(item => `
                        <li>
                            <span class="detail-item-icon">ðŸ‘¤</span>
                            <div class="detail-item-copy">
                                <strong>${escapeHtml(item.fullName || "Trainer")}</strong>
                                <span>ðŸ‹ï¸ Specialization: ${escapeHtml(item.specialization || "General Fitness")}</span>
                                <span>ðŸ“§ Email: ${escapeHtml(item.email || "Not available")}</span>
                                <span>ðŸ“ž Phone: ${escapeHtml(item.phone || "Not available")}</span>
                            </div>
                        </li>
                    `).join("")}
                </ul>
            `;
        }

        popup.classList.add("active");
        document.body.style.overflow = "hidden";
    }

    function closeDetailPopup() {
        const popup = document.getElementById("classDetailPopup");
        if (!popup) return;
        popup.classList.remove("active");
        document.body.style.overflow = "";
    }

    async function loadTrainerOptions(selectId = "trainer") {

        const trainerSelect = document.getElementById(selectId);

        if (!trainerSelect) {
            return;
        }

        try {
            const response = await fetch("/api/trainers");

            if (!response.ok) {
                throw new Error("Unable to load trainers.");
            }

            const trainers = await response.json();

            trainerSelect.innerHTML = `
                <option value="">Select Trainer...</option>
                ${trainers.map(t => `
                    <option value="${t.id}">${escapeHtml(t.fullName || "Trainer")}</option>
                `).join("")}
            `;

            return trainers;
        }
        catch (error) {
            console.error(error);
            trainerSelect.innerHTML = `
                <option value="">Unable to load trainers</option>
            `;
            return [];
        }
    }


    async function loadClasses() {

        const rows = document.getElementById("genericRows");

        rows.innerHTML = `
            <tr>
                <td colspan="6" class="class-loading">
                    Loading classes...
                </td>
            </tr>
        `;

        try {
            const response = await fetch("/api/classes");

            if (!response.ok) {
                throw new Error("Unable to load classes.");
            }

            const classes = await response.json();
            renderClasses(classes);
            updateClassSummary(classes);
        }
        catch (error) {
            console.error(error);
            rows.innerHTML = `
                <tr>
                    <td colspan="6" class="class-loading">
                        Unable to load classes.
                    </td>
                </tr>
            `;
        }
    }


    function updateClassSummary(classes) {

        const list = Array.isArray(classes) ? classes : [];
        const total = list.length;

        const scheduleEl = document.getElementById("classScheduleSummary");
        const trainerEl = document.getElementById("trainerSummary");

        if (scheduleEl) {
            scheduleEl.textContent = total
                ? `${total} scheduled class${total > 1 ? "es" : ""} are available in the system.`
                : "No class schedule information is available yet.";
        }

        if (trainerEl) {
            const trainerCount = list.filter(item => item.trainer && item.trainer.fullName).length;
            trainerEl.textContent = trainerCount
                ? `${trainerCount} trainer assignment${trainerCount > 1 ? "s" : ""} are currently linked to class schedules.`
                : "No trainer assignments are set for the registered classes yet.";
        }
    }


    function renderClasses(classes) {

        const rows = document.getElementById("genericRows");

        if (!classes || classes.length === 0) {
            rows.innerHTML = `
                <tr>
                    <td colspan="6" class="class-loading">
                        No classes have been registered yet.
                    </td>
                </tr>
            `;
            return;
        }

        rows.innerHTML = classes.map(item => {
            const trainerName = item.trainer?.fullName || item.trainerName || item.trainer || "Not assigned";
            const className = item.name || item.className || "Untitled Class";
            const capacity = Number(item.capacity) || 0;
            const status = (item.status || "Pending").toString();
            const badgeClass = (status || "pending").toLowerCase();

            return `
                <tr>
                    <td><strong>#${item.id ?? ""}</strong></td>
                    <td><strong>${escapeHtml(className)}</strong></td>
                    <td>${escapeHtml(trainerName)}</td>
                    <td>${formatSchedule(item)}</td>
                    <td>${capacity} Members</td>
                    <td>
                        <span class="class-badge ${badgeClass}">${status}</span>
                        <button type="button" class="mini-edit-btn" data-class-id="${item.id ?? ""}" onclick="openEditClassModal(${item.id ?? 0})">Edit</button>
                    </td>
                </tr>
            `;
        }).join("");
    }


    async function addClass(event) {

        event.preventDefault();

        const message = document.getElementById("classMessage");
        const saveButton = document.querySelector(".save-class-btn");

        const sessionType = document.getElementById("classType").value;
        const startTime = document.getElementById("startTime").value;
        const endTime = document.getElementById("endTime").value;
        const status = document.getElementById("classStatus").value;

        const trainerValue = document.getElementById("trainer").value;
        const trainerId = trainerValue && trainerValue !== "" ? Number(trainerValue) : null;

        const classData = {
            name: document.getElementById("className").value.trim(),
            trainerId,
            description: sessionType,
            sessionType,
            startTime,
            endTime,
            status: trainerId ? status : "Pending",
            scheduleDate: null,
            durationMinutes: 60,
            capacity: Number(document.getElementById("capacity").value)
        };

        saveButton.disabled = true;
        saveButton.innerHTML = "Saving...";

        try {
            const response = await fetch("/api/classes", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(classData)
            });

            if (!response.ok) {
                throw new Error("Class could not be saved.");
            }

            message.className = "class-message success";
            message.textContent = "âœ“ Class added successfully.";

            document.getElementById("addClassForm").reset();
            await loadClasses();

            setTimeout(() => {
                closeAddClassModal();
            }, 1000);
        }
        catch (error) {
            console.error(error);
            message.className = "class-message error";
            message.textContent = "Unable to save class. Please try again.";
        }
        finally {
            saveButton.disabled = false;
            saveButton.innerHTML = "<span>ï¼‹</span> Save Class";
        }
    }

    async function saveClassEdits(event) {
        event.preventDefault();

        const classId = document.getElementById("editClassId").value;
        const message = document.getElementById("editClassMessage");
        const saveButton = document.querySelector("#editClassForm .save-class-btn");

        if (!classId) {
            message.className = "class-message error";
            message.textContent = "Class id is missing.";
            return;
        }

        const sessionType = document.getElementById("editClassType").value;
        const startTime = document.getElementById("editStartTime").value;
        const endTime = document.getElementById("editEndTime").value;
        const status = document.getElementById("editClassStatus").value;

        const trainerValue = document.getElementById("editTrainer").value;
        const trainerId = trainerValue && trainerValue !== "" ? Number(trainerValue) : null;

        const classData = {
            id: Number(classId),
            name: document.getElementById("editClassName").value.trim(),
            trainerId,
            description: sessionType,
            sessionType,
            startTime,
            endTime,
            status: trainerId ? status : "Pending",
            scheduleDate: null,
            durationMinutes: 60,
            capacity: Number(document.getElementById("editCapacity").value)
        };

        saveButton.disabled = true;
        saveButton.innerHTML = "Updating...";

        try {
            const response = await fetch(`/api/classes/${classId}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(classData)
            });

            if (!response.ok) {
                throw new Error("Class could not be updated.");
            }

            message.className = "class-message success";
            message.textContent = "âœ“ Class updated successfully.";

            await loadClasses();

            setTimeout(() => {
                closeEditClassModal();
            }, 1000);
        }
        catch (error) {
            console.error(error);
            message.className = "class-message error";
            message.textContent = "Unable to update class. Please try again.";
        }
        finally {
            saveButton.disabled = false;
            saveButton.innerHTML = "<span>âœ“</span> Update Class";
        }
    }

    async function openEditClassModal(classId) {
        try {
            const response = await fetch("/api/classes");
            if (response.ok) {
                const classes = await response.json();
                classDataCache.splice(0, classDataCache.length, ...classes);
            }
        }
        catch (error) {
            console.error(error);
        }

        const item = classDataCache.find(x => Number(x.id) === Number(classId));
        if (!item) {
            return;
        }

        await loadTrainerOptions("editTrainer");

        document.getElementById("editClassId").value = item.id ?? "";
        document.getElementById("editClassName").value = item.name || item.className || "";
        document.getElementById("editClassType").value = item.sessionType || item.description || "Morning";
        document.getElementById("editStartTime").value = item.startTime || "08:00 AM";
        document.getElementById("editEndTime").value = item.endTime || "10:00 AM";
        document.getElementById("editCapacity").value = Number(item.capacity) || 0;

        const trainerSelect = document.getElementById("editTrainer");
        if (trainerSelect) {
            const trainerValue = item.trainerId ?? (item.trainer ? item.trainer.id : "");
            trainerSelect.value = trainerValue || "";
        }

        const statusField = document.getElementById("editClassStatus");
        if (statusField) {
            statusField.value = item.status || (trainerSelect && !trainerSelect.value ? "Pending" : "Pending");
            if (!trainerSelect || !trainerSelect.value) {
                statusField.value = "Pending";
            }
        }

        document.getElementById("editClassModal").classList.add("active");
        document.body.style.overflow = "hidden";
    }

    function closeEditClassModal() {
        document.getElementById("editClassModal").classList.remove("active");
        document.body.style.overflow = "";
        const message = document.getElementById("editClassMessage");
        if (message) {
            message.className = "class-message";
            message.textContent = "";
        }
    }

    function applyPendingDefaultWhenNoTrainer(trainerSelectId, statusSelectId) {
        const trainerSelect = document.getElementById(trainerSelectId);
        const statusSelect = document.getElementById(statusSelectId);

        if (!trainerSelect || !statusSelect) {
            return;
        }

        const shouldBePending = !trainerSelect.value || trainerSelect.value === "";
        if (shouldBePending) {
            statusSelect.value = "Pending";
        }
    }

    function openAddClassModal() {
        loadTrainerOptions();
        const statusField = document.getElementById("classStatus");
        if (statusField) {
            statusField.value = "Pending";
        }
        document.getElementById("addClassModal").classList.add("active");
        document.body.style.overflow = "hidden";
    }


    function closeAddClassModal() {
        document.getElementById("addClassModal").classList.remove("active");
        document.body.style.overflow = "";
        document.getElementById("classMessage").className = "class-message";
    }


    function formatSchedule(item) {
        const sessionType = item.sessionType || item.description || "Morning";
        const startTime = item.startTime || item.start || "";
        const endTime = item.endTime || item.end || "";
        const timeRange = startTime && endTime ? `${startTime} - ${endTime}` : (startTime || item.classTime || item.time || "");

        if (timeRange) {
            return `${sessionType} â€¢ ${timeRange}`;
        }

        return `${sessionType} â€¢ Schedule not set`;
    }


    function escapeHtml(value) {
        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }


    document.addEventListener("DOMContentLoaded", async function () {
        bindInfoCards();
        loadTrainerOptions();

        const trainerField = document.getElementById("trainer");
        const addStatusField = document.getElementById("classStatus");
        if (trainerField && addStatusField) {
            trainerField.addEventListener("change", () => applyPendingDefaultWhenNoTrainer("trainer", "classStatus"));
            applyPendingDefaultWhenNoTrainer("trainer", "classStatus");
        }

        const editTrainerField = document.getElementById("editTrainer");
        const editStatusField = document.getElementById("editClassStatus");
        if (editTrainerField && editStatusField) {
            editTrainerField.addEventListener("change", () => applyPendingDefaultWhenNoTrainer("editTrainer", "editClassStatus"));
        }

        await Promise.all([loadDetailData(), loadClasses()]);

        document.getElementById("classDetailClose")?.addEventListener("click", closeDetailPopup);
        document.getElementById("classDetailPopup")?.addEventListener("click", (event) => {
            if (event.target.id === "classDetailPopup") {
                closeDetailPopup();
            }
        });
    });

</script>
