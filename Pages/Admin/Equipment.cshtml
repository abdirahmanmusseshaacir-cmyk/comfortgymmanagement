</style>


<script>

    /* =====================================================
       LOAD EQUIPMENT
    ====================================================== */

    async function loadEquipment() {

        const tbody =
            document.getElementById(
                "equipmentRows"
            );


        tbody.innerHTML = `
            <tr>
                <td colspan="3"
                    class="equipment-loading">

                    Loading equipment...

                </td>
            </tr>
        `;


        try {

            const response =
                await fetch(
                    "/api/equipment"
                );


            if (!response.ok) {

                throw new Error(
                    "Unable to load equipment."
                );

            }


            const equipment =
                await response.json();


            if (!equipment ||
                equipment.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="3"
                            class="equipment-loading">

                            No equipment has been registered yet.

                        </td>
                    </tr>
                `;

                return;
            }


            tbody.innerHTML =
                equipment
                    .map(renderEquipment)
                    .join("");

        }
        catch (error) {

            console.error(error);


            tbody.innerHTML = `
                <tr>
                    <td colspan="3"
                        class="equipment-loading">

                        Unable to load equipment.
                        Please try again.

                    </td>
                </tr>
            `;

        }

    }


    /* =====================================================
       RENDER EQUIPMENT
    ====================================================== */

    function renderEquipment(item) {

        const id = item.id ?? "";
        const name = item.name ?? item.equipmentName ?? "Unknown Equipment";
        const quantity = item.quantity ?? 0;
        const status = item.status ?? "Active";

        return `

            <tr>

                <td>

                    <div class="equipment-item">

                        <div class="equipment-item-image">

                            <img
                                src="/images/equipment-item.svg"
                                alt="Equipment">

                        </div>

                        <div>

                            <strong>
                                ${esc(name)}
                            </strong>

                            <small>
                                Gym Equipment
                            </small>

                        </div>

                    </div>

                </td>

                <td>
                    ${esc(quantity)}
                </td>

                <td>
                    <select class="equipment-status-select" data-equipment-id="${esc(id)}" aria-label="Equipment status for ${esc(name)}">
                        <option value="Active" ${status === "Active" ? "selected" : ""}>Active</option>
                        <option value="Inactive" ${status === "Inactive" ? "selected" : ""}>Inactive</option>
                    </select>
                </td>

            </tr>

        `;

    }


    document.addEventListener("change", async function (event) {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement) || !target.classList.contains("equipment-status-select")) {
            return;
        }

        const equipmentId = target.dataset.equipmentId;
        if (!equipmentId) {
            return;
        }

        const nextStatus = target.value;

        try {
            const response = await fetch(`/api/equipment/${equipmentId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: Number(equipmentId), name: "", quantity: 0, status: nextStatus })
            });

            if (!response.ok) {
                throw new Error("Unable to update equipment status.");
            }

            await loadEquipment();
        } catch (error) {
            console.error(error);
            alert("Unable to update equipment status.");
            await loadEquipment();
        }
    });

    /* =====================================================
       ADD EQUIPMENT
    ====================================================== */

    async function addEquipment(event) {

        event.preventDefault();


        const message =
            document.getElementById(
                "equipmentMessage"
            );


        const saveButton =
            document.getElementById(
                "saveEquipmentBtn"
            );


        const equipmentData = {

            name:
                document
                    .getElementById(
                        "equipmentName"
                    )
                    .value
                    .trim(),

            quantity:
                Number(
                    document
                        .getElementById(
                            "equipmentQuantity"
                        )
                        .value
                ),

            status:
                document
                    .getElementById(
                        "equipmentStatus"
                    )
                    .value

        };


        saveButton.disabled = true;

        saveButton.innerHTML =
            "Saving...";


        try {

            const response =
                await fetch(
                    "/api/equipment",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(
                                equipmentData
                            )
                    }
                );


            if (!response.ok) {

                const errorText =
                    await response.text();


                throw new Error(
                    errorText ||
                    "Equipment could not be saved."
                );

            }


            message.className =
                "equipment-message success";


            message.textContent =
                "âœ“ Equipment added successfully.";


            document
                .getElementById(
                    "equipmentForm"
                )
                .reset();


            /*
             * Immediately refresh table
             */

            await loadEquipment();


            setTimeout(
                closeEquipmentModal,
                1000
            );

        }
        catch (error) {

            console.error(error);


            message.className =
                "equipment-message error";


            message.textContent =
                "Unable to save equipment. Please check the API and try again.";

        }
        finally {

            saveButton.disabled = false;

            saveButton.innerHTML =
                "âœ“ Save Equipment";

        }

    }


    /* =====================================================
       OPEN MODAL
    ====================================================== */

    function openEquipmentModal() {

        document
            .getElementById(
                "equipmentModal"
            )
            .classList
            .add("active");


        document.body.style.overflow =
            "hidden";

    }


    /* =====================================================
       CLOSE MODAL
    ====================================================== */

    function closeEquipmentModal() {

        document
            .getElementById(
                "equipmentModal"
            )
            .classList
            .remove("active");


        document.body.style.overflow =
            "";


        const message =
            document.getElementById(
                "equipmentMessage"
            );


        message.className =
            "equipment-message";


        message.textContent =
            "";

    }


    /* =====================================================
       ESCAPE HTML
    ====================================================== */

    function esc(value) {

        return String(value)

            .replaceAll(
                "&",
                "&amp;"
            )

            .replaceAll(
                "<",
                "&lt;"
            )

            .replaceAll(
                ">",
                "&gt;"
            )

            .replaceAll(
                '"',
                "&quot;"
            )

            .replaceAll(
                "'",
                "&#039;"
            );

    }


    /* =====================================================
       LOAD WHEN PAGE OPENS
    ====================================================== */

    document.addEventListener(
        "DOMContentLoaded",
        loadEquipment
    );

</script>
