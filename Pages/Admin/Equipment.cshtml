@page
@{
    ViewData["Title"] = "Equipment";
}

<div class="equipment-page">

    <!-- HERO -->
    <section class="equipment-hero">

        <div class="equipment-hero-overlay"></div>

        <div class="equipment-hero-content">

            <span class="equipment-label">
                COMFORT GYM MANAGEMENT SYSTEM
            </span>

            <h1>
                Gym Equipment
            </h1>

            <p>
                Manage gym equipment inventory with item names,
                quantities and active or inactive status.
            </p>

            <div class="equipment-hero-actions">

                <button type="button"
                        class="equipment-add-btn"
                        onclick="openEquipmentModal()">

                    <span>+</span>
                    Add Equipment

                </button>

                <button type="button"
                        class="equipment-refresh-hero"
                        onclick="loadEquipment()">

                    â†» Refresh

                </button>

            </div>

        </div>

    </section>


    <!-- INFORMATION CARDS -->
    <section class="equipment-info-section">

        <div class="equipment-info-card">

            <div class="equipment-info-image">

                <img src="/images/equipment-inventory.svg"
                     alt="Equipment Inventory">

            </div>

            <div class="equipment-info-content">

                <span>01</span>

                <h4>
                    Equipment Inventory
                </h4>

                <p>
                    Keep an organized record of all equipment
                    available inside the gym.
                </p>

            </div>

        </div>


        <div class="equipment-info-card">

            <div class="equipment-info-image">

                <img src="/images/equipment-condition.svg"
                     alt="Equipment Condition">

            </div>

            <div class="equipment-info-content">

                <span>02</span>

                <h4>
                    Equipment Status
                </h4>

                <p>
                    Track which items are active and which are
                    temporarily inactive in the gym.
                </p>

            </div>

        </div>


        <div class="equipment-info-card">

            <div class="equipment-info-image">

                <img src="/images/equipment-management.svg"
                     alt="Equipment Management">

            </div>

            <div class="equipment-info-content">

                <span>03</span>

                <h4>
                    Inventory Control
                </h4>

                <p>
                    Keep a simple record of equipment quantity and
                    current availability for daily operations.
                </p>

            </div>

        </div>

    </section>


    <!-- MANAGEMENT PANEL -->
    <section class="equipment-management-panel">

        <div class="equipment-panel-header">

            <div class="equipment-panel-title">

                <div class="equipment-panel-image">

                    <img src="/images/equipment-panel.svg"
                         alt="Equipment Management">

                </div>

                <div>

                    <h3>
                        Equipment Management
                    </h3>

                    <p>
                        View and manage all registered gym equipment.
                    </p>

                </div>

            </div>


            <div class="equipment-panel-actions">

                <button type="button"
                        class="equipment-refresh-btn"
                        onclick="loadEquipment()">

                    â†» Refresh Equipment

                </button>

                <button type="button"
                        class="equipment-panel-add-btn"
                        onclick="openEquipmentModal()">

                    + Add Equipment

                </button>

            </div>

        </div>

    </section>


    <!-- EQUIPMENT DIRECTORY -->
    <section class="equipment-directory">

        <div class="equipment-table-header">

            <div>

                <h3>
                    Equipment Directory
                </h3>

                <p>
                    Registered gym equipment and current status
                </p>

            </div>

            <div class="equipment-live-status">

                <span></span>

                Live Data

            </div>

        </div>


        <div class="equipment-table-wrapper">

            <table class="equipment-table">

                <thead>

                    <tr>

                        <th>
                            Equipment
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody id="equipmentRows">

                    <tr>

                        <td colspan="3"
                            class="equipment-loading">

                            Loading equipment...

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </section>

</div>


<!-- =====================================================
     ADD EQUIPMENT MODAL
====================================================== -->

<div id="equipmentModal"
     class="equipment-modal">

    <div class="equipment-modal-overlay"
         onclick="closeEquipmentModal()">
    </div>


    <div class="equipment-modal-box">

        <div class="equipment-modal-header">

            <div>

                <span>
                    COMFORT GYM MANAGEMENT SYSTEM
                </span>

                <h2>
                    Add New Equipment
                </h2>

                <p>
                    Register new gym equipment in the system.
                </p>

            </div>


            <button type="button"
                    class="equipment-modal-close"
                    onclick="closeEquipmentModal()">

                Ã—

            </button>

        </div>


        <form id="equipmentForm"
              onsubmit="addEquipment(event)">

            <div class="equipment-form-grid">


                <!-- NAME -->

                <div class="equipment-form-group">

                    <label>
                        Equipment Name
                    </label>

                    <input type="text"
                           id="equipmentName"
                           placeholder="e.g. Treadmill"
                           required>

                </div>


                <!-- QUANTITY -->

                <div class="equipment-form-group">

                    <label>
                        Quantity
                    </label>

                    <input type="number"
                           id="equipmentQuantity"
                           min="1"
                           placeholder="e.g. 5"
                           required>

                </div>

                <!-- STATUS -->

                <div class="equipment-form-group">

                    <label>
                        Status
                    </label>

                    <select id="equipmentStatus">
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                </div>

            </div>


            <div id="equipmentMessage"
                 class="equipment-message">
            </div>


            <div class="equipment-form-actions">

                <button type="button"
                        class="equipment-cancel-btn"
                        onclick="closeEquipmentModal()">

                    Cancel

                </button>

                <button type="submit"
                        id="saveEquipmentBtn"
                        class="equipment-save-btn">

                    âœ“ Save Equipment

                </button>

            </div>

        </form>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }


    .equipment-page {
        width: 100%;
        min-height: 100vh;
        padding-bottom: 50px;
        background: #f5f7fa;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .equipment-hero {
        position: relative;
        min-height: 410px;

        display: flex;
        align-items: center;

        overflow: hidden;

        background-image:
            url('/images/equipment-hero.svg');

        background-size: cover;
        background-position: center;
    }

    .equipment-hero-overlay {
        position: absolute;
        inset: 0;

        background:
