@page
@{
    ViewData["Title"] = "Payments";
}

<div class="payments-page">
    <!-- HERO -->
    <div class="payments-hero">
        <div class="payments-hero-content">
            <span class="payments-label">COMFORT GYM MANAGEMENT SYSTEM</span>
            <h1>Payment & Financial Management</h1>
            <p>
                Diiwaangeli oo maamul dhammaan lacag-bixinta xubnaha, rasiidhada (receipts), iyo dakhliga ka soo gala xubinnimada bille ee Comfort Gym.
            </p>
        </div>
    </div>

    <!-- STATS -->
    <div class="payment-stats-grid">
        <div class="pstat-card income">
            <div class="pstat-icon">💰</div>
            <div class="pstat-body">
                <small>Wadarta Dakhliga Guud</small>
                <h3 id="pTotalRevenue">$0.00</h3>
            </div>
        </div>
        <div class="pstat-card month">
            <div class="pstat-icon">📅</div>
            <div class="pstat-body">
                <small>Dakhliga Bishan</small>
                <h3 id="pMonthlyRevenue">$0.00</h3>
            </div>
        </div>
        <div class="pstat-card receipts">
            <div class="pstat-icon">🧾</div>
            <div class="pstat-body">
                <small>Tirada Rasiidhada</small>
                <h3 id="pReceiptsCount">0</h3>
            </div>
        </div>
    </div>

    <!-- RECORD PAYMENT FORM -->
    <div class="panel" style="margin-bottom:24px;">
        <div class="payments-header">
            <div>
                <span class="payment-section-label">LACAG QABASHADA (RECORD PAYMENT)</span>
                <h3>Diiwaangeli Lacag-Bixin Cusub</h3>
                <p>Dooro xubinta, geli qiimaha, iyo habka lacagta (EVC Plus, Zaad, Sahal, Cash, Card).</p>
            </div>
        </div>

        <form id="paymentForm" onsubmit="handleRecordPayment(event)" class="payment-form">
            <div class="form-group">
                <label>Dooro Xubinta (Select Member) *</label>
                <select id="payMemberSelect" required>
                    <option value="">Xubnaha ayaa la soo gelinayaa...</option>
                </select>
            </div>

            <div class="form-group">
                <label>Qadarka Lacagta ($ Amount) *</label>
                <input type="number" step="0.01" id="payAmount" value="30.00" required />
            </div>

            <div class="form-group">
                <label>Habka Lacag-bixinta (Payment Method) *</label>
                <select id="payMethod">
                    <option value="EVC Plus">EVC Plus (Hormuud/Telesom)</option>
                    <option value="Zaad">Zaad Service</option>
                    <option value="Sahal">Sahal Service</option>
                    <option value="Cash" selected>Kaash (Cash)</option>
                    <option value="Card">Kaadhka Bangiga (Bank Card)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Faallo / Sababta Lacagta (Notes)</label>
                <input type="text" id="payNotes" value="Monthly Membership Fee" />
            </div>

            <button type="submit" class="payment-submit-btn" id="paySubmitBtn">
                + Qabo Lacagta & Samee Rasiid (Save Payment)
            </button>
        </form>
        <div id="payMsg" class="payment-message"></div>
    </div>

    <!-- TRANSACTIONS TABLE -->
    <div class="panel">
        <div class="payments-header" style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <span class="payment-section-label">DIWAANKA LACAGAHA (PAYMENT HISTORY)</span>
                <h3>Dhammaan Lacag-Bixinnadii La Qabtay</h3>
            </div>
            <button type="button" class="payment-refresh-btn" onclick="loadPaymentsData()">↻ Cusboonaysii</button>
        </div>

        <div class="payments-table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Xubinta</th>
                        <th>Qadarka ($)</th>
                        <th>Habka</th>
                        <th>Taariikhda</th>
                        <th>Qoraal</th>
                        <th>Rasiid</th>
                    </tr>
                </thead>
                <tbody id="paymentsRows">
                    <tr><td colspan="7" class="text-center py-4">Xogta lacagaha ayaa la soo gelinayaa...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- =========================================================
     PRINTABLE RECEIPT MODAL
     ========================================================= -->
<div id="receiptModal" class="receipt-modal">
    <div class="receipt-box">
        <div class="receipt-print-content" id="printableReceipt">
            <div class="rec-header">
                <h2>🏋️ COMFORT GYM</h2>
                <p>KM4, Hodan District, Mogadishu, Somalia</p>
                <p>Tel: +252 61 5000000 | Email: billing@comfortgym.com</p>
                <div class="rec-badge">RASIID RASMI AH / OFFICIAL RECEIPT</div>
            </div>

            <div class="rec-meta">
                <div>
                    <strong>Invoice #:</strong> <span id="rInvoiceNo">INV-0000</span><br />
                    <strong>Taariikhda:</strong> <span id="rDate">-</span>
                </div>
                <div style="text-align:right;">
                    <strong>Habka:</strong> <span id="rMethod">Cash</span><br />
                    <strong>Xaaladda:</strong> <span style="color:#15803d; font-weight:800;">✓ PAID</span>
                </div>
            </div>

            <div class="rec-client">
                <strong>Laga helay (Received From):</strong>
                <h4 id="rMemberName" style="margin:4px 0 2px; font-size:16px;">-</h4>
                <small id="rMemberInfo">-</small>
            </div>

            <table class="rec-table">
                <thead>
                    <tr>
                        <th>Sharaxaad (Description)</th>
                        <th style="text-align:right;">Qadarka</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong id="rDesc">Monthly Gym Membership</strong><br />
                            <small id="rNotes">-</small>
                        </td>
                        <td style="text-align:right; font-weight:800;" id="rAmount">$0.00</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <th>WADARTA GUUD (TOTAL PAID):</th>
                        <th style="text-align:right; font-size:16px;" id="rTotal">$0.00</th>
                    </tr>
                </tfoot>
            </table>

            <div class="rec-footer">
                <div>
                    <div style="height:35px; border-bottom:1px dashed #94a3b8; width:140px; margin-bottom:4px;"></div>
                    <small>Saxiixa Maamulka (Authorized)</small>
                </div>
                <div style="text-align:right;">
                    <p style="margin:0; font-weight:700; color:#15803d;">Mahadsanid! Thank You!</p>
                    <small>Comfort Gym Management System</small>
                </div>
            </div>
        </div>

        <div class="receipt-actions">
            <button type="button" class="qbtn blue" onclick="window.print()">🖨️ Daabac Rasiidka (Print)</button>
            <button type="button" class="qbtn" style="background:#64748b;" onclick="closeReceiptModal()">Xir (Close)</button>
        </div>
    </div>
</div>

<style>
.payments-page {
    width: 100%;
    padding-bottom: 40px;
}

.payments-hero {
    min-height: 180px;
    border-radius: 18px;
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    padding: 30px 40px;
    background: linear-gradient(135deg, #091223 0%, #1e293b 100%);
    color: white;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
}
.payments-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #60a5fa;
    display: block;
    margin-bottom: 8px;
}
.payments-hero h1 { margin: 0 0 10px; font-size: 30px; }
.payments-hero p { margin: 0; color: #cbd5e1; font-size: 14px; max-width: 650px; line-height: 1.6; }

/* STATS */
.payment-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}
.pstat-card {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 18px 22px;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.pstat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
}
.pstat-card.income .pstat-icon { background: linear-gradient(135deg, #ecfdf5 0%, #dcfce7 100%); }
.pstat-card.month .pstat-icon { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); }
.pstat-card.receipts .pstat-icon { background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); }
.pstat-icon {
    font-size: 28px;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.08);
}
.pstat-body { display: flex; flex-direction: column; gap: 4px; }
.pstat-card small { font-size: 12px; font-weight: 700; color: #64748b; display: block; }
.pstat-card h3 { margin: 0; font-size: 24px; font-weight: 800; color: #0f172a; }

/* FORM */
.panel {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 20px 18px;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.04);
}
.payment-section-label { font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: #2563eb; display: block; margin-bottom: 4px; }
.payments-header h3 { margin: 0 0 4px; font-size: 20px; color: #0f172a; }
.payments-header p { margin: 0; font-size: 13px; color: #64748b; }
.payment-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 16px;
}
.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.form-group label {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
}
.form-group input,
.form-group select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #d8e1ee;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    background: white;
}
.payment-submit-btn {
    grid-column: 1 / -1;
    min-height: 48px;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: white;
    font-size: 14px;
    font-weight: 800;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 12px 18px rgba(22, 163, 74, 0.18);
}
.payment-submit-btn:hover { background: #15803d; }
.payment-message { margin-top: 12px; font-weight: 700; font-size: 13px; }
.payment-refresh-btn {
    padding: 9px 16px;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 18px rgba(15, 23, 42, 0.14);
}

/* TABLE */
.payments-table-wrapper { width: 100%; overflow-x: auto; margin-top: 14px; }
.payments-table-wrapper table { width: 100%; border-collapse: collapse; min-width: 800px; }
.payments-table-wrapper th {
    background: #f8fafc;
    padding: 12px 10px;
    text-align: left;
    font-size: 12px;
    font-weight: 800;
    color: #475569;
    border-bottom: 1px solid #e2e8f0;
}
.payments-table-wrapper td {
    padding: 12px 10px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 13px;
    color: #334155;
}
.payments-table-wrapper tbody tr:hover { background: #f8fafc; }
.qbtn {
    background: #eff6ff;
    color: #1d4ed8;
    border: none;
    border-radius: 8px;
    padding: 7px 11px;
    font-weight: 700;
    cursor: pointer;
}
.qbtn.blue {
    background: #dbeafe;
    color: #1d4ed8;
}

/* RECEIPT MODAL */
.receipt-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
}
.receipt-modal.active { display: flex; }
.receipt-box {
    background: white;
    width: 100%;
    max-width: 520px;
    border-radius: 16px;
    padding: 26px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}
.receipt-print-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
}
.rec-header { text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 14px; margin-bottom: 16px; }
.rec-header h2 { margin: 0 0 4px; color: #0f172a; }
.rec-header p { margin: 0; font-size: 11px; color: #64748b; }
.rec-badge {
    display: inline-block;
    margin-top: 8px;
    background: #0f172a;
    color: white;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 12px;
}
.rec-meta { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 14px; color: #334155; }
.rec-client { background: #f8fafc; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 12px; }
.rec-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
.rec-table th { background: #f1f5f9; padding: 8px; font-size: 12px; text-align: left; }
.rec-table td { padding: 10px 8px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
.rec-table tfoot th { padding: 10px 8px; border-top: 2px solid #0f172a; }
.rec-footer { display: flex; justify-content: space-between; align-items: flex-end; padding-top: 14px; border-top: 1px dashed #cbd5e1; }
.receipt-actions { display: flex; gap: 10px; justify-content: center; margin-top: 18px; }
</style>

<script>
let paymentsList = [];
let membersLookup = [];

document.addEventListener('DOMContentLoaded', () => {
    loadMembersForSelect();
    loadPaymentsData();
});

async function loadMembersForSelect() {
    try {
        const res = await fetch('/api/members');
        if (!res.ok) return;
        membersLookup = await res.json();
        const sel = document.getElementById('payMemberSelect');
        if (!sel) return;
        sel.innerHTML = '<option value="">-- Dooro Xubinta (Select Member) --</option>' +
            membersLookup.map(m => `<option value="${m.id}">#${m.id} - ${escapeHtml(m.fullName)} (${m.status})</option>`).join('');
    } catch (e) { console.error(e); }
}

async function loadPaymentsData() {
    const tbody = document.getElementById('paymentsRows');
    if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4">Xogta ayaa la soo gelinayaa...</td></tr>';

    try {
        const res = await fetch('/api/payments');
        if (!res.ok) throw new Error('Cilad ayaa dhacday soo gelinta lacagaha.');
        paymentsList = await res.json();

        let total = 0;
        paymentsList.forEach(p => { total += Number(p.amount) || 0; });
        document.getElementById('pTotalRevenue').textContent = '$' + total.toFixed(2);
        document.getElementById('pMonthlyRevenue').textContent = '$' + total.toFixed(2);
        document.getElementById('pReceiptsCount').textContent = paymentsList.length;

        if (paymentsList.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:25px; color:#64748b;">Wax lacag-bixin ah lama diiwaangelin wali.</td></tr>';
            return;
        }

        tbody.innerHTML = paymentsList.map(p => {
            const memberName = p.member?.fullName || `Member #${p.memberId}`;
            const inv = p.invoiceNumber || `INV-${p.id}`;
            const dateStr = new Date(p.paymentDate).toLocaleString();

            return `
                <tr>
                    <td><strong>${escapeHtml(inv)}</strong></td>
                    <td><strong>${escapeHtml(memberName)}</strong></td>
                    <td><strong style="color:#15803d;">$${Number(p.amount).toFixed(2)}</strong></td>
                    <td><span style="background:#eff6ff; color:#2563eb; padding:3px 8px; border-radius:6px; font-weight:700; font-size:11px;">${escapeHtml(p.paymentMethod || 'Cash')}</span></td>
                    <td><span style="font-size:12px; color:#64748b;">${dateStr}</span></td>
                    <td><small style="color:#64748b;">${escapeHtml(p.notes || '-')}</small></td>
                    <td>
                        <button type="button" class="qbtn blue" style="padding:4px 9px; font-size:11px;" onclick="viewReceipt(${p.id})">
                            🖨️ Rasiid
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    } catch (err) {
        console.error(err);
        if (tbody) tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:25px; color:#dc2626;">Cilad ayaa dhacday.</td></tr>';
    }
}

async function handleRecordPayment(e) {
    e.preventDefault();
    const btn = document.getElementById('paySubmitBtn');
    const msg = document.getElementById('payMsg');
    const memberId = parseInt(document.getElementById('payMemberSelect').value, 10);
    const amount = parseFloat(document.getElementById('payAmount').value) || 0;
    const method = document.getElementById('payMethod').value;
    const notes = document.getElementById('payNotes').value;

    if (!memberId) {
        msg.textContent = 'Fadlan dooro xubin!';
        msg.style.color = '#dc2626';
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Lacagta ayaa la diiwaangelinayaa...';

    try {
        const res = await fetch('/api/payments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                memberId: memberId,
                amount: amount,
                paymentMethod: method,
                notes: notes
            })
        });

        if (!res.ok) throw new Error('Lama diiwaangelin karin lacagta.');
        const created = await res.json();

        msg.textContent = '✅ Lacag-bixinta si guul leh ayaa loo diiwaangeliyey!';
        msg.style.color = '#16a34a';

        document.getElementById('paymentForm').reset();
        await loadPaymentsData();

        // Automatically open receipt
        viewReceipt(created.id);
    } catch (err) {
        msg.textContent = '❌ ' + err.message;
        msg.style.color = '#dc2626';
    } finally {
        btn.disabled = false;
        btn.textContent = '+ Qabo Lacagta & Samee Rasiid (Save Payment)';
    }
}

function viewReceipt(paymentId) {
    const p = paymentsList.find(x => x.id === paymentId);
    if (!p) return;

    const memberName = p.member?.fullName || `Member #${p.memberId}`;
    const inv = p.invoiceNumber || `INV-${p.id}`;

    document.getElementById('rInvoiceNo').textContent = inv;
    document.getElementById('rDate').textContent = new Date(p.paymentDate).toLocaleString();
    document.getElementById('rMethod').textContent = p.paymentMethod || 'Cash';
    document.getElementById('rMemberName').textContent = memberName;
    document.getElementById('rMemberInfo').textContent = `Member ID: CG-${String(p.memberId).padStart(4, '0')} • ${p.member?.phone || ''}`;
    document.getElementById('rNotes').textContent = p.notes || 'Monthly Gym Access';
    document.getElementById('rAmount').textContent = '$' + Number(p.amount).toFixed(2);
    document.getElementById('rTotal').textContent = '$' + Number(p.amount).toFixed(2);

    document.getElementById('receiptModal').classList.add('active');
}

function closeReceiptModal() {
    document.getElementById('receiptModal').classList.remove('active');
}

function escapeHtml(str) {
    return String(str ?? '').replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    })[m]);
}
</script>