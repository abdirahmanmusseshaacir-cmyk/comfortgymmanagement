@page
@{ Layout = null; ViewData["Title"] = "Comfort Gym"; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Comfort Gym</title>
    <style>
        :root {
            --bg: #edf1f4;
            --panel: rgba(255, 255, 255, 0.2);
            --border: #d7dde4;
            --text: #0f172a;
            --muted: #4b5563;
            --button: #1a2433;
            --button-hover: #0f172a;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 24px 18px 36px;
        }

        .landing-shell {
            width: min(100%, 1680px);
            margin: 0 auto;
        }

        .landing-card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 32px 28px 34px;
            min-height: 260px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.03);
            animation: fadeUp 0.7s ease both;
        }

        .landing-card h1 {
            margin: 0;
            font-size: clamp(2.8rem, 5vw, 8rem);
            line-height: 0.96;
            letter-spacing: -0.07em;
            font-weight: 900;
            color: var(--text);
            animation: slideIn 0.8s ease both;
        }

        .landing-copy {
            margin-top: 18px;
            color: var(--muted);
            font-size: clamp(1.1rem, 1.6vw, 2.1rem);
            animation: fadeUp 0.9s ease both;
        }

        .landing-btn {
            display: inline-block;
            margin-top: 28px;
            background: var(--button);
            color: #fff;
            text-decoration: none;
            padding: 16px 28px;
            border-radius: 12px;
            font-size: 1.05rem;
            font-weight: 800;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
            transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
            animation: fadeUp 1.1s ease both;
        }

        .landing-btn:hover {
            background: var(--button-hover);
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.18);
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-12px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@media (max-width: 760px) {
            body {
                padding: 16px 12px 24px;
            }

            .landing-card {
                padding: 22px 18px 24px;
                border-radius: 14px;
            }

            .landing-copy {
                margin-top: 12px;
            }

            .landing-btn {
                margin-top: 20px;
                padding: 14px 22px;
            }
        }
    </style>
</head>
<body>
    <div class="landing-shell">
        <main class="landing-card">
            <h1>COMFORT GYM MANAGEMENT SYSTEM</h1>
            <div class="landing-copy">Welcome to the system.</div>
            <a class="landing-btn" href="/Account/Login">Login</a>
        </main>
    </div>
</body>
</html>

